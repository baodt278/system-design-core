flowchart TB
    Users[Người dùng]
    Router[Bộ định tuyến/Gateway]

    subgraph New["Dịch vụ mới"]
        AuthNew[Dịch vụ xác thực<br/>Đã chuyển]
        PaymentNew[Dịch vụ thanh toán<br/>Đã chuyển]
    end

    subgraph Old["Nguyên khối"]
        Users2[Mô-đun người dùng<br/>⏳ Chưa chuyển]
        Orders2[Mô-đun đơn hàng<br/>⏳ Chưa chuyển]
    end

    Users --> Router
    Router -->|/auth/*| AuthNew
    Router -->|/payment/*| PaymentNew
    Router -->|/users/*| Old
    Router -->|/orders/*| Old
